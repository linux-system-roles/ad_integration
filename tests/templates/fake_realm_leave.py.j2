import sys

state_file = "{{ __leave_tmp.path }}/realms"
log_file = "{{ __leave_tmp.path }}/calls"
args = sys.argv[1:]

with open(state_file) as stream:
    realms = [line.strip() for line in stream if line.strip()]

if "list" in args:
    if "--name-only" not in args:
        sys.exit(2)
    for realm in realms:
        print(realm)
elif "leave" in args:
    target = args[-1]
    if target.lower() not in [realm.lower() for realm in realms]:
        sys.exit(3)
    remote = "--remove" in args
    user = any(arg.startswith("--user=") for arg in args)
    password_ok = sys.stdin.read().strip() == "Secret123" if remote else True
    if remote and (not user or not password_ok):
        sys.exit(4)
    with open(log_file, "a") as stream:
        stream.write("{} {}\n".format(target.lower(), "remote" if remote else "local"))
    with open(state_file, "w") as stream:
        for realm in realms:
            if realm.lower() != target.lower():
                stream.write(realm + "\n")
else:
    sys.exit(5)
